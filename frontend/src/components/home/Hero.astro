---
import { Image } from "astro:assets";
import arrow from "../../assets/icons/arrow.svg";
import location from "../../assets/icons/location.svg";
import road from "../../assets/icons/road.svg";
import computer from "../../assets/icons/computer.svg";
---

<section class="hero-section">
  <div class="container content">
    <h1>Mental Performance for <span>Athletes, People, and Teams</span></h1>
    <!-- <p>To develop focus, confidence, emotional control, and consistency in high-pressure environments.</p> -->
    <p>Therapeutic support for people navigating various challenges in their life</p>
    <a href="" class="btn">SCHEDULE YOUR SESSION <Image src={arrow} alt="" /></a>
    <ul>
      <li><Image src={location} alt="" />Chicago based</li>
      <li><Image src={road} alt="" />Potential outside of Chicago</li>
      <li><Image src={computer} alt="" />Online Format</li>
    </ul>
  </div>
  <div></div>
</section>

<style>
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-image:
      linear-gradient(to right, var(--bg-color) 40%, rgba(0, 0, 0, 0.5)), url("../../assets/images/hero-img.jpg");
    background-size: cover;
    background-position: center;
    & .content {
      display: grid;
      gap: 20px;
      & h1 {
        font: var(--font-h1);
        color: var(--white);
        & span {
          color: var(--blue-span);
          font-style: italic;
        }
      }
      & p {
        font: var(--font-p1);
        color: var(--white);
        width: 40ch;
      }
      & a {
        width: fit-content;
      }
      & ul {
        display: flex;
        flex-direction: column;
        gap: 20px;
        & li {
          display: flex;
          gap: 20px;
          align-items: center;
          font: var(--font-p2);
          color: var(--white);
        }
      }
    }
  }

  @media (max-width: 1366px) {
    .hero-section {
      background-image:
        linear-gradient(to right, var(--bg-color) 45%, rgba(0, 0, 0, 0.5)), url("../../assets/images/hero-img.jpg");
    }
  }

  @media (max-width: 440px) {
    .hero-section {
      grid-template-columns: 1fr;
      & .content {
        & ul {
          gap: 10px;
        }
      }
    }
  }
</style>
