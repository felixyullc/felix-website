---
import { Image } from "astro:assets";
import logo from "../../assets/logos/logo_felix.svg";
import email from "../../assets/icons/email.svg";
import linkedin from "../../assets/icons/linkedin.svg";
---

<footer>
  <div class="upper-footer">
    <div class="img">
      <a href="/"> <Image class="logo" src={logo} alt="" /></a>
    </div>
    <div class="content">
      <div class="text">
        <p>Mental performance support for athletes, coaches, parents and teams.</p>
        <p>Therapeutic support for people navigating various challenges in their life.</p>
      </div>
      <ul class="links">
        <li><a href="mailto:felix@felixyullc.com"><Image src={email} alt="" /></a></li>
        <li>
          <a href="https://www.linkedin.com/company/felix-yu-llc/" target="_blank"><Image src={linkedin} alt="" /></a>
        </li>
      </ul>
      <ul class="nav">
        <li><a href="#about-me">About</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#services-details">Process</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </div>
  </div>

  <div class="lower-footer">
    <div>
      <p>© <span id="current-year"></span> Felix Yu LLC. All rights reserved</p>
      <!-- initial year 2026 -->
    </div>
    <span>Website designed and managed by <a href="https://leo-crixi.com/" target="_blank">Leo Crixi</a></span>
    <a href="/privacy-policy">Terms & Privacy Policy</a>
  </div>
</footer>

<style>
  footer {
    & .upper-footer {
      margin: 0 auto;
      justify-content: center;
      background: var(--blue-bg);
      padding: 40px 80px;
      display: flex;
      flex-wrap: wrap;
      gap: 80px;
      & .img img {
        width: 250px;
      }
      & .content {
        & .text {
          & p {
            font: var(--font-p1);
            color: var(--blue);
            text-align: center;
          }
        }
        & .links {
          display: flex;
          gap: 100px;
          padding: 40px 0px;
          justify-content: center;
          & img {
            width: 25px;
            height: 25px;
          }
        }
        & .nav {
          display: flex;
          gap: 40px;
          justify-content: center;
          & a {
            font: var(--font-p1);
          }
        }
      }
    }
    & .lower-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-around;
      padding: 40px;
      gap: 40px;
      & p,
      span,
      a {
        font: var(--font-p2);
      }
      & span a {
        color: var(--blue-span);
        &:hover {
          text-decoration: underline;
        }
      }
      & a:hover {
        text-decoration: underline;
      }
    }
  }
  @media (max-width: 440px) {
    footer {
      & .upper-footer {
        gap: 20px;
      }
      & .lower-footer {
        gap: 20px;
      }
    }
  }
</style>
